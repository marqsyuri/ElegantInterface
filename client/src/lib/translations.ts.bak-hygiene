/**
 * Obtém a tradução para uma chave específica
 * @param key - Chave da tradução
 * @param language - Idioma (padrão: pt-BR)
 * @returns Texto traduzido ou a chave se não encontrado
 */
export function t(key: TranslationKey, language: string = 'pt-BR'): string {
  const lang = language || 'pt-BR';
  const langTranslations = translations[lang] || translations['pt-BR'];
  return langTranslations[key] || key;
}

/**
 * Exporta todas as traduções (útil para debug)
 */
export { translations };

/**
 * Lista de idiomas suportados
 */
export const supportedLanguages = Object.keys(translations);

